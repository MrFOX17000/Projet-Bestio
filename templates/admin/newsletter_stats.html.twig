{% extends 'base.html.twig' %}

{% block title %}Statistiques Newsletter - Admin{% endblock %}

{% block body %}
<div class="app-content">
    <div class="content">
        <!-- Navigation -->
        <div class="mb-20">
            <a href="{{ path('app_admin') }}" class="btn btn-primary-stroke">
                <i class="fas fa-arrow-left mr-5"></i>
                Retour à l'admin
            </a>
        </div>

        <!-- En-tête -->
        <div class="mb-30">
            <h1 class="d-flex justify-content-center margin-auto mb-10">📊 Statistiques Newsletter</h1>
            <p class="d-flex gray-dark justify-content-center margin-auto">Tableau de bord complet des abonnements</p>
        </div>

        <!-- Statistiques générales -->
        <div class="stats-overview mb-30 mt-20">
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-icon" style="background: #28a745;">📧</div>
                    <div class="stat-info">
                        <div class="stat-number">{{ stats.active }}</div>
                        <div class="stat-label">Abonnés actifs</div>
                    </div>
                </div>
                
                <div class="stat-card">
                    <div class="stat-icon" style="background: #17a2b8;">👥</div>
                    <div class="stat-info">
                        <div class="stat-number">{{ stats.total }}</div>
                        <div class="stat-label">Total inscrits</div>
                    </div>
                </div>
                
                <div class="stat-card">
                    <div class="stat-icon" style="background: #ffc107;">📈</div>
                    <div class="stat-info">
                        <div class="stat-number">{{ stats.thisMonth }}</div>
                        <div class="stat-label">Ce mois-ci</div>
                    </div>
                </div>
                
                <div class="stat-card">
                    <div class="stat-icon" style="background: #dc3545;">❌</div>
                    <div class="stat-info">
                        <div class="stat-number">{{ stats.inactive }}</div>
                        <div class="stat-label">Désabonnés</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <!-- Répartition par fréquence -->
            <div class="col-md-6 mb-30">
                <div class="newsletter-stats-card">
                    <div class="card-header">
                        <h3>📅 Répartition par fréquence</h3>
                    </div>
                    <div class="card-content">
                        <div class="frequency-stats">
                            <div class="frequency-item">
                                <div class="frequency-bar">
                                    <div class="frequency-fill weekly" style="width: {{ frequencyStats.weekly > 0 ? (frequencyStats.weekly / (frequencyStats.weekly + frequencyStats.monthly) * 100) : 0 }}%"></div>
                                </div>
                                <div class="frequency-info">
                                    <strong>Hebdomadaire</strong>
                                    <span>{{ frequencyStats.weekly }} abonnés</span>
                                </div>
                            </div>
                            
                            <div class="frequency-item">
                                <div class="frequency-bar">
                                    <div class="frequency-fill monthly" style="width: {{ frequencyStats.monthly > 0 ? (frequencyStats.monthly / (frequencyStats.weekly + frequencyStats.monthly) * 100) : 0 }}%"></div>
                                </div>
                                <div class="frequency-info">
                                    <strong>Mensuelle</strong>
                                    <span>{{ frequencyStats.monthly }} abonnés</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Top domaines email -->
            <div class="col-md-6 mb-30">
                <div class="newsletter-stats-card">
                    <div class="card-header">
                        <h3>🏢 Top domaines email</h3>
                    </div>
                    <div class="card-content">
                        <div class="domains-list">
                            {% for domain, count in topDomains %}
                                <div class="domain-item">
                                    <span class="domain-name">{{ domain }}</span>
                                    <span class="domain-count">{{ count }}</span>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Évolution des abonnements -->
        <div class="newsletter-stats-card mb-30 mt-10">
            <div class="card-header">
                <h3>📈 Évolution des abonnements (12 derniers mois)</h3>
            </div>
            <div class="card-content">
                <div class="trend-chart">
                    {% set maxCount = 0 %}
                    {% for month in trend %}
                        {% if month.count > maxCount %}
                            {% set maxCount = month.count %}
                        {% endif %}
                    {% endfor %}

                    <div class="chart-container">
                        {% for month in trend %}
                            <div class="chart-bar">
                                <div class="bar-fill" style="height: {{ maxCount > 0 ? (month.count / maxCount * 100) : 0 }}%"></div>
                                <div class="bar-value">{{ month.count }}</div>
                                <div class="bar-label">{{ month.month }}</div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
    margin-bottom: 30px;
}

.stat-card {
    background: white;
    padding: 20px;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    display: flex;
    align-items: center;
    gap: 15px;
}

.stat-icon {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    color: white;
}

.stat-number {
    font-size: 24px;
    font-weight: bold;
    color: #333;
}

.stat-label {
    font-size: 14px;
    color: #666;
}

.newsletter-stats-card {
    background: white;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    overflow: hidden;
}

.card-header {
    background: #f8f9fa;
    padding: 20px;
    border-bottom: 1px solid #eee;
}

.card-header h3 {
    margin: 0;
    color: #333;
    font-size: 18px;
}

.card-content {
    padding: 20px;
}

.frequency-item {
    margin-bottom: 15px;
}

.frequency-bar {
    width: 100%;
    height: 8px;
    background: #eee;
    border-radius: 4px;
    overflow: hidden;
    margin-bottom: 5px;
}

.frequency-fill.weekly {
    background: #28a745;
}

.frequency-fill.monthly {
    background: #17a2b8;
}

.frequency-fill {
    height: 100%;
    transition: width 0.3s ease;
}

.frequency-info {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 14px;
}

.domains-list {
    max-height: 250px;
    overflow-y: auto;
}

.domain-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 0;
    border-bottom: 1px solid #f0f0f0;
}

.domain-name {
    font-family: monospace;
    color: #555;
}

.domain-count {
    font-weight: bold;
    color: #8B5A3C;
    background: #f0f0f0;
    padding: 2px 8px;
    border-radius: 12px;
    font-size: 12px;
}

.chart-container {
    display: flex;
    align-items: end;
    gap: 8px;
    height: 200px;
    padding: 20px 0;
}

.chart-bar {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 100%;
}

.bar-fill {
    width: 100%;
    background: linear-gradient(45deg, #8B5A3C, #A0522D);
    border-radius: 4px 4px 0 0;
    min-height: 4px;
    transition: height 0.5s ease;
}

.bar-value {
    font-size: 12px;
    font-weight: bold;
    color: #333;
    margin: 5px 0;
}

.bar-label {
    font-size: 10px;
    color: #666;
    transform: rotate(-45deg);
    white-space: nowrap;
}

.quick-actions {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
}

.row {
    display: flex;
    gap: 20px;
}

.col-md-6 {
    flex: 1;
}
</style>
{% endblock %}