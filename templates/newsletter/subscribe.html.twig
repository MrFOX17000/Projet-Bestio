{% extends 'base.html.twig' %}

{% block title %}Newsletter Bestio - Restez connecté à la nature{% endblock %}

{% block body %}
<div class="app-content">
    <div class="content">
        <!-- En-tête Newsletter -->
        <div class="newsletter-hero">
            <div class="newsletter-hero-content">
                <div class="hero-icon">🐾</div>
                <h1>Newsletter Bestio</h1>
                <p class="hero-subtitle">Découvrez chaque semaine les merveilles du monde animal</p>
                {% if is_granted('ROLE_ADMIN') %}
                    <div class="hero-stats">
                        <div class="stat-item">
                            <span class="stat-number">{{ stats.active }}</span>
                            <span class="stat-label">Abonnés</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-number">{{ stats.thisMonth }}</span>
                            <span class="stat-label">Ce mois-ci</span>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>

        <div class="newsletter-content">
            <!-- Formulaire d'abonnement -->
            <div class="newsletter-main">
                <div class="newsletter-form-card">
                    <div class="form-header">
                        <div class="form-icon">📧</div>
                        <h2>S'abonner à la newsletter</h2>
                        <p class="form-description">
                            Recevez nos dernières découvertes, articles passionnants et réponses aux questions 
                            les plus intéressantes de notre communauté d'amoureux des animaux.
                        </p>
                    </div>

                    <div class="newsletter-form">
                        {{ form_start(form) }}
                            <div class="form-group">
                                {{ form_label(form.email, 'Votre adresse email') }}
                                {{ form_widget(form.email, {'attr': {'class': 'newsletter-input', 'placeholder': 'exemple@email.com'}}) }}
                                {{ form_errors(form.email) }}
                            </div>

                            <div class="form-group">
                                {{ form_label(form.frequency, 'Fréquence d\'envoi préférée') }}
                                <div class="frequency-options">
                                    {{ form_widget(form.frequency) }}
                                </div>
                                {{ form_errors(form.frequency) }}
                            </div>

                            <div class="form-group">
                                {{ form_widget(form.subscribe, {'attr': {'class': 'newsletter-submit-btn'}}) }}
                            </div>
                        {{ form_end(form) }}
                    </div>

                    <div class="privacy-notice">
                        <i class="fas fa-shield-alt"></i>
                        Nous respectons votre vie privée. Vous pouvez vous désabonner à tout moment.
                    </div>
                </div>

                <!-- Aperçu du contenu -->
                <div class="newsletter-preview-card">
                    <div class="preview-header">
                        <div class="preview-icon">📋</div>
                        <h3>Ce que vous recevrez</h3>
                    </div>
                    <div class="preview-content">
                        <div class="preview-item">
                            <div class="item-icon">📝</div>
                            <div class="item-content">
                                <h4>Articles récents</h4>
                                <p>Les derniers articles de notre blog animalier</p>
                            </div>
                        </div>
                        
                        <div class="preview-item">
                            <div class="item-icon">🦎</div>
                            <div class="item-content">
                                <h4>Espèce mise en avant</h4>
                                <p>Focus sur une espèce fascinante avec photos et faits</p>
                            </div>
                        </div>
                        
                        <div class="preview-item">
                            <div class="item-icon">💬</div>
                            <div class="item-content">
                                <h4>Questions populaires</h4>
                                <p>Les discussions les plus intéressantes du forum</p>
                            </div>
                        </div>
                        
                        <div class="preview-item">
                            <div class="item-icon">📊</div>
                            <div class="item-content">
                                <h4>Statistiques du site</h4>
                                <p>Nouvelles espèces, membres, découvertes</p>
                            </div>
                        </div>
                    </div>

                    <div class="preview-action">
                        <a href="{{ path('newsletter_preview') }}" class="preview-btn">
                            <i class="fas fa-eye"></i>
                            Voir un aperçu complet
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}