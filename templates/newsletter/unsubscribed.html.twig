{% extends 'base.html.twig' %}

{% block title %}Désabonnement Newsletter - Bestio{% endblock %}

{% block body %}
<div class="app-content">
    <div class="content">
        <div class="unsubscribe-container text-center">
            <div class="unsubscribe-card block p-20 mx-auto" style="max-width: 500px;">
                <div class="unsubscribe-icon mb-20">
                    <i class="fas fa-envelope-open" style="font-size: 4rem; color: var(--primary);"></i>
                </div>
                
                <h1 class="mb-15">Désabonnement confirmé</h1>
                
                <p class="mb-20">
                    L'adresse email <strong>{{ email }}</strong> a été désabonnée de notre newsletter.
                </p>
                
                <div class="farewell-message mb-20 p-15" style="background: #f8f9fa; border-radius: 8px;">
                    <p class="mb-10">
                        <strong>Nous espérons vous revoir bientôt ! 🐾</strong>
                    </p>
                    <p class="text-small gray-dark mb-0">
                        Votre passion pour les animaux nous manquera dans notre communauté.
                    </p>
                </div>
                
                <div class="unsubscribe-actions">
                    <a href="{{ path('newsletter_subscribe') }}" class="btn btn-primary mb-10">
                        <i class="fas fa-undo mr-5"></i>
                        Me réabonner
                    </a>
                    <br>
                    <a href="{{ path('app_home') }}" class="btn btn-primary-stroke">
                        <i class="fas fa-home mr-5"></i>
                        Retour à l'accueil
                    </a>
                </div>
                
                <div class="feedback-section mt-20 pt-20" style="border-top: 1px solid #dee2e6;">
                    <p class="text-small gray-dark mb-15">
                        <strong>Pourquoi vous désabonnez-vous ?</strong><br>
                        Aidez-nous à améliorer notre newsletter
                    </p>
                    
                    <div class="feedback-options text-small">
                        <div class="feedback-item mb-5">
                            <i class="fas fa-circle mr-5" style="font-size: 0.5rem;"></i>
                            Trop d'emails
                        </div>
                        <div class="feedback-item mb-5">
                            <i class="fas fa-circle mr-5" style="font-size: 0.5rem;"></i>
                            Contenu pas assez intéressant
                        </div>
                        <div class="feedback-item mb-5">
                            <i class="fas fa-circle mr-5" style="font-size: 0.5rem;"></i>
                            J'ai trouvé mes informations ailleurs
                        </div>
                        <div class="feedback-item mb-5">
                            <i class="fas fa-circle mr-5" style="font-size: 0.5rem;"></i>
                            Plus intéressé par les animaux
                        </div>
                    </div>
                    
                    <p class="text-small gray-dark mt-15">
                        <a href="mailto:contact@bestio.com" class="underline">Contactez-nous</a> 
                        pour nous faire part de vos commentaires
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.unsubscribe-container {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
}

.unsubscribe-card {
    border-radius: var(--border-radius);
    box-shadow: var(--box-shadow);
}

.farewell-message {
    border-left: 4px solid var(--primary);
}

.feedback-item {
    color: #666;
    text-align: left;
}

.underline:hover {
    text-decoration: underline;
}
</style>
{% endblock %}