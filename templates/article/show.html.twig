{% extends 'base.html.twig' %}

{% block title %}{{ article.titreArticle }} - Blog Bestio{% endblock %}

{% block body %}
<div class="app-content">
    <div class="content">
    <!-- Bouton retour original -->
        <div class="article-footer d-flex justify-content-between align-items-center">
                            <a href="{{ path('app_article') }}" class="btn btn-primary-stroke">
                                Retour aux articles
                                <i class="fas fa-arrow-right ml-5"></i>
                            </a>
                        </div>
        <!-- Article principal -->
        <article class="article-detail">
            <!-- En-tête de l'article -->
            <header class="article-header mb-20">
                <h1 class="article-main-title mb-15">{{ article.titreArticle }}</h1>
                
                <!-- Métadonnées de l'article -->
                <div class="article-meta-detailed d-flex align-items-center mb-20">
                    <div class="author-section d-flex align-items-center mr-20">
                        <div class="avatar avatar-md m-20">
                            {% if article.redacteur.photo %}
                                {% set avatarUrl = article.redacteur.photo starts with('/') ? asset(article.redacteur.photo) : asset('uploads/avatar/' ~ article.redacteur.photo) %}
                                <img src="{{ avatarUrl }}" alt="{{ article.redacteur.pseudo }}">
                            {% else %}
                                <img src="{{ asset('images/profil.webp') }}" alt="{{ article.redacteur.pseudo }}">
                            {% endif %}
                        </div>
                        <div class="author-details">
                            <span class="author-name bold">{{ article.redacteur.pseudo }}</span>
                            <div class="publish-date text-small">
                                <i class="fas fa-calendar mr-5"></i>
                                Publié le {{ article.dateArticle|date('d/m/Y à H:i') }}
                            </div>
                        </div>
                    </div>
                    
                    <div class="reading-meta text-small gray-dark mr-20">
                        <i class="fas fa-clock mr-5"></i>
                        ~ {{ (article.contenuArticle|length / 800)|round }} min de lecture
                    </div>
                </div>
            </header>

            <!-- Image de l'article (si présente) -->
            {% if article.image %}
                <div class="article-featured-image mb-20">
                    <img src="{{ article.image }}" alt="{{ article.titreArticle }}" class="featured-img">
                </div>
            {% endif %}

            <!-- Contenu de l'article -->
            <div class="article-body">
                <div class="article-content">
                    {{ article.contenuArticle|nl2br }}
                </div>
            </div>
        </article>
    </div>
</div>
{% endblock %}
