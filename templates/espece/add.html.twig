{% extends 'base.html.twig' %}

{% block title %}Ajouter une espèce{% endblock %}


{% block body %}
<div id="wrapper-categorie">
    {% if is_granted('ROLE_ADMIN') %}
        {{ form_start(form) }}
            {{ form_widget(form) }}
            <button aria-label="Enregistrer" type="submit" class="btn btn-primary">Enregistrer</button>
        {{ form_end(form) }}

        <h1>Liste des espèces</h1>
        {% for espece in especes %}
            {{ espece.nomEspece }}
            <a href="{{ path('edit_espece', {'id': espece.id}) }}">
                <i class="fa-solid fa-pen-to-square"></i>       
            </a>
            <a href="{{ path('delete_espece', {'id': espece.id}) }}" onclick="return confirm('Êtes-vous sûr de vouloir supprimer cette espèce ?');">
                <i class="fa-solid fa-trash"></i>
            </a> <br>
        {% endfor %}
    {% else %}        
        <p>Vous n'avez pas les droits pour accéder à cette page.</p>
    {% endif %}
</div>
{% endblock %}

