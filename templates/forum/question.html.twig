{% extends 'base.html.twig' %}
{% block title %}Question{% endblock %}

{% block body %}
<div class="newsletter-hero">
  <div class="newsletter-hero-content d-flex flex-column align-items-center gap-40">
      <h1>{{ question.titreQuestion }}</h1>
      <div class="sort-bar">
          <span>Commentaires :</span>
          <a class="{{ sortComments == 'top' ? 'active' : '' }}"
             href="{{ path('app_forum_question_show',{nom_espece: nom_espece, id: question.id, sort:'top'}) }}">Pertinence</a>
          <a class="{{ sortComments == 'recent' ? 'active' : '' }}"
             href="{{ path('app_forum_question_show',{nom_espece: nom_espece, id: question.id, sort:'recent'}) }}">Récent</a>
      </div>
  </div>
</div>

<section class="forum-question-wrapper">
    <article class="forum-item forum-item--question">
        {% if question.author %}
            <a class="author-chip" title="Voir le profil"
               href="{{ path('user',{id: question.author.id}) }}">
               <img src="{{ question.author.photo ?? asset('images/profil.webp') }}" alt="Avatar {{ question.author }}">
            </a>
        {% endif %}

        <div class="forum-votes vote-box"
             data-type="question"
             data-id="{{ question.id }}"
             data-auth="{{ app.user ? '1':'0' }}"
             data-owner="{{ app.user and question.author and app.user.id == question.author.id ? '1':'0' }}">
            <button class="vote-btn up {{ question.getUserVote(app.user) == 1 ? 'active' : '' }}">▲</button>
            <span class="vote-score">{{ question.getScore() }}</span>
            <button class="vote-btn down {{ question.getUserVote(app.user) == -1 ? 'active' : '' }}">▼</button>
        </div>

        <div class="forum-content">
            {% set qtxt = '' %}
            {% for prop in ['contenuQuestion','contenu','content','description','texte'] %}
                {% if qtxt == '' and attribute(question,prop) is defined and attribute(question,prop) %}
                    {% set qtxt = attribute(question,prop)|striptags %}
                {% endif %}
            {% endfor %}
            {% if qtxt == '' and question.getExcerpt is defined %}
                {% set qtxt = question.getExcerpt(500) %}
            {% endif %}

            <div class="forum-body">{{ qtxt }}</div>
            <div class="forum-meta">
                <small>
                    Posté le {% if question.createdAt is defined %}{{ question.createdAt|date('d/m/Y H:i') }}{% endif %}
                    {% if question.author %} • par {{ question.author }}{% endif %}
                    • Score {{ question.getScore() }}
                </small>
            </div>
        </div>
    </article>
</section>

<section class="comment-section">
    <h2 class="comment-section-title">Commentaires</h2>

    <div class="comment-list">
        {% for c in commentaires %}
            <div class="comment-item">
                {% if c.author %}
                    <a class="author-chip author-chip--comment" title="Voir le profil"
                       href="{{ path('user',{id: c.author.id}) }}">
                       <img src="{{ c.author.photo ?? asset('images/profil.webp') }}" alt="Avatar {{ c.author }}">
                    </a>
                {% endif %}

                <div class="comment-votes vote-box small"
                     data-type="commentaire"
                     data-id="{{ c.id }}"
                     data-auth="{{ app.user ? '1':'0' }}"
                     data-owner="{{ app.user and c.author and app.user.id == c.author.id ? '1':'0' }}">
                    <button class="vote-btn up {{ c.getUserVote(app.user) == 1 ? 'active' : '' }}">▲</button>
                    <span class="vote-score">{{ c.getScore() }}</span>
                    <button class="vote-btn down {{ c.getUserVote(app.user) == -1 ? 'active' : '' }}">▼</button>
                </div>
                <div class="comment-content-wrap">
                    {% set ctxt = '' %}
                    {% for prop in ['contenuCommentaire','contenu','content','texte','body'] %}
                        {% if ctxt == '' and attribute(c,prop) is defined and attribute(c,prop) %}
                            {% set ctxt = attribute(c,prop)|striptags %}
                        {% endif %}
                    {% endfor %}
                    <div class="comment-text">{{ ctxt }}</div>
                    <div class="comment-meta-line">
                        <small>
                            {{ c.createdAtComm is defined ? c.createdAtComm|date('d/m/Y H:i') : '' }}
                            {% if c.author %} • par {{ c.author }}{% endif %}
                            • Score {{ c.getScore() }}
                        </small>

                        {% if app.user and (app.user.id == c.author.id or 'ROLE_ADMIN' in app.user.roles) %}
                            <a href="{{ path('delete_commentaire', { id: c.id }) }}"
                            class="delete-comment"
                            title="Supprimer le commentaire"
                            onclick="return confirm('Voulez-vous vraiment supprimer ce commentaire ?');">
                                🗑️
                            </a>
                        {% endif %}

                    </div>
                </div>
            </div>
        {% else %}
            <div class="forum-empty">Aucun commentaire.</div>
        {% endfor %}
    </div>
</section>

{% if formComm is defined and formComm %}
<section class="comment-add-wrapper">
    <div class="forum-form-hero">
        <div class="forum-form-hero-icon">🐾</div>
        <h2 class="forum-form-hero-title">Ajouter un commentaire</h2>
        <p class="forum-form-hero-sub">Partagez votre réponse ou précisions pour aider la discussion.</p>
    </div>

    {% if app.user and app.user.banned %}
        {% if app.user.bannedUntil %}
            <div class="ban-message">
                🚫 Vous êtes temporairement banni jusqu’au {{ app.user.bannedUntil|date('d/m/Y H:i') }}.
                Vous ne pouvez pas publier de commentaires pour le moment.
            </div>
        {% else %}
            <div class="ban-message">
                🚫 Vous êtes banni définitivement. Vous ne pouvez plus poster de commentaires.
            </div>
        {% endif %}
    {% else %}
        <div class="forum-form-card">
            {{ form_start(formComm, { attr:{ class:'forum-form'} }) }}

                {# Détection du champ texte principal #}
                {% set possibles = ['contenuCommentaire','contenu','content','texte','body','message','description'] %}
                {% set fieldName = null %}
                {% for name in possibles %}
                    {% if fieldName is null and formComm[name] is defined %}
                        {% set fieldName = name %}
                    {% endif %}
                {% endfor %}

                {% if fieldName %}
                    <div class="form-row">
                        {{ form_label(formComm[fieldName], 'Votre commentaire :', { label_attr:{ class:'ff-label'} }) }}
                        {{ form_widget(formComm[fieldName], { attr:{ class:'ff-textarea'} }) }}
                        {{ form_errors(formComm[fieldName]) }}
                    </div>
                {% else %}
                    {% for child in formComm %}
                        <div class="form-row">
                            {{ form_row(child) }}
                        </div>
                    {% endfor %}
                {% endif %}

                <div class="form-actions">
                    <button class="ff-submit-btn" type="submit">Publier mon commentaire</button>
                </div>
            {{ form_end(formComm) }}
        </div>
    {% endif %}
</section>
{% endif %}
{% endblock %}