{% extends 'base.html.twig' %}
{% block title %}Questions - {{ nom_espece }}{% endblock %}

{% block body %}
<div class="newsletter-hero">
  <div class="newsletter-hero-content d-flex flex-column align-items-center gap-40">
      <h1>Questions sur {{ nom_espece }}</h1>
      <div class="sort-bar">
          <span>Trier :</span>
          <a class="{{ sort == 'top' ? 'active' : '' }}" href="{{ path('app_forum_show',{nom_espece: nom_espece, sort:'top'}) }}">Pertinence</a>
          <a class="{{ sort == 'recent' ? 'active' : '' }}" href="{{ path('app_forum_show',{nom_espece: nom_espece, sort:'recent'}) }}">Récent</a>
      </div>
  </div>
</div>

<div class="forum-list">
  {% for q in questions %}
      <article class="forum-item">
          {# Avatar auteur question #}
          {% if q.author %}
              <a class="author-chip" title="Voir le profil"
                 href="{{ path('user',{id: q.author.id}) }}">
                 <img src="{{ q.author.photo ?? asset('images/profil.webp') }}" alt="Avatar {{ q.author }}">
              </a>
          {% endif %}

          <div class="forum-votes vote-box"
               data-type="question"
               data-id="{{ q.id }}"
               data-auth="{{ app.user ? '1':'0' }}"
               data-owner="{{ app.user and q.author and app.user.id == q.author.id ? '1':'0' }}">
              <button class="vote-btn up {{ q.getUserVote(app.user) == 1 ? 'active' : '' }}" aria-label="Vote positif">▲</button>
              <span class="vote-score">{{ q.getScore() }}</span>
              <button class="vote-btn down {{ q.getUserVote(app.user) == -1 ? 'active' : '' }}" aria-label="Vote négatif">▼</button>
          </div>

          <div class="forum-content">
              <h2 class="forum-title">
                  <a href="{{ path('app_forum_question_show',{nom_espece: nom_espece, id: q.id, sort: sort}) }}">{{ q.titreQuestion }}</a>
              </h2>

              {% set txt = '' %}
              {% for prop in ['contenuQuestion','contenu','content','description','texte'] %}
                  {% if txt == '' and attribute(q,prop) is defined and attribute(q,prop) %}
                      {% set txt = attribute(q,prop)|striptags %}
                  {% endif %}
              {% endfor %}
              {% if txt == '' and q.getExcerpt is defined %}
                  {% set txt = q.getExcerpt() %}
              {% endif %}
              <p class="forum-excerpt">
                  {% if txt|length > 230 %}{{ txt|slice(0,230) ~ '…' }}{% else %}{{ txt }}{% endif %}
              </p>

              <div class="forum-meta">
                  <small>
                      Posté le {% if q.createdAt is defined %}{{ q.createdAt|date('d/m/Y H:i') }}{% endif %}
                      {% if q.author %} • par {{ q.author }}{% endif %}
                      • Score {{ q.getScore() }}
                  </small>

                  {% if app.user and (app.user.id == q.author.id or is_granted('ROLE_ADMIN')) %}
                    <a href="{{ path('delete_question', { id: q.id }) }}"
                    class="delete-question"
                    title="Supprimer la question"
                    onclick="return confirm('Voulez-vous vraiment supprimer cette question ?');">
                        🗑️
                    </a>
                {% endif %}


              </div>
          </div>
      </article>
  {% else %}
      <div class="forum-empty">Aucune question.</div>
  {% endfor %}
</div>
{% endblock %}