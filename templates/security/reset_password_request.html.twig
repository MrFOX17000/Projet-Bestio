{% extends "base.html.twig" %}

{% block title %}Réinitialiser le mot de passe{% endblock %}

{% block body %}
    <div class="fill">
        <!-- Section héros avec gradient -->
        <div class="form-hero">
            <div class="form-hero-content">
                <span class="form-icon">🐾</span>
                <h1>Mot de passe oublié</h1>
                <p>Nous allons vous envoyer un email pour réinitialiser votre mot de passe</p>
            </div>
        </div>

        <!-- Formulaire avec le nouveau style -->
        <div class="form-container">
            {{ form_start(form) }}
            {{ form_rest(form) }}
            <button type="submit" class="btn btn-primary">Envoyer le lien de réinitialisation</button>
            {{ form_end(form) }}

            <div class="form-links">
                <div><a href="{{ path('connexion') }}">Retour à la connexion</a></div>
                <div class="mt-10"><a href="{{ path('app_register') }}">Créer un compte</a></div>
            </div>
        </div>
    </div>
{% endblock %}
