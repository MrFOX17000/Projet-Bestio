{% extends "base.html.twig" %}

{% block title %}Nouveau mot de passe{% endblock %}

{% block body %}
    <div class="fill">
        <!-- Section héros avec gradient -->
        <div class="form-hero">
            <div class="form-hero-content">
                <span class="form-icon">🐾</span>
                <h1>Nouveau mot de passe</h1>
                <p>Choisissez un nouveau mot de passe sécurisé</p>
            </div>
        </div>

        <!-- Formulaire avec le nouveau style -->
        <div class="form-container">
            {{ form_start(form) }}
            {{ form_rest(form) }}
            <button type="submit" class="btn btn-primary">Confirmer le nouveau mot de passe</button>
            {{ form_end(form) }}

            <div class="form-links">
                <div><a href="{{ path('connexion') }}">Retour à la connexion</a></div>
            </div>
        </div>
    </div>
{% endblock %}